@model List<EchoNet.Models.Song>
@using System.Text.Json
@inject EchoNet.Utils.AppDataJsonReader AppDataJsonReader
@{AppData? appData = AppDataJsonReader.Current;}

<link rel="stylesheet" href="~/css/songs/_songs.css" asp-append-version="true"/>

<div class="songs-page">
    <div class="header" id="header">
        <div class="header-nav">
            <div class="header-left">
                <h1 class="header-title">Songs</h1>
                <span class="song-count" id="songCountDisplay">@Model.Count songs</span>
            </div>
            <div class="header-right">
                <span class="sort-label">Sort</span>
                <div class="sort-group" id="sortGroup">
                    <button class="sort-btn @(appData.SortType == "newest" ? "active" : string.Empty)" data-sort="newest">Newest</button>
                    <button class="sort-btn @(appData.SortType == "oldest" ? "active" : string.Empty)" data-sort="oldest">Oldest</button>
                    <button class="sort-btn @(appData.SortType == "az" ? "active" : string.Empty)" data-sort="az">A – Z</button>
                    <button class="sort-btn @(appData.SortType == "za" ? "active" : string.Empty)" data-sort="za">Z – A</button>
                </div>
                <div class="header-extra">
                    <div class="view-toggle">
                        <button class="view-toggle-btn @(appData.ViewType == "list" ? "active-view" : string.Empty)" data-view="list" title="List view">☰</button>
                        <button class="view-toggle-btn @(appData.ViewType == "grid" ? "active-view" : string.Empty)" data-view="grid" title="Grid view">⊞</button>
                    </div>
                    <button class="add-btn" id="pickMusicBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Add
                    </button>
                </div>
            </div>
        </div>

        <div class="column-headers" id="columnHeaders">
            <div class="col-index">#</div>
            <div class="col-artwork"></div>
            <div class="col-title">Title</div>
            <div class="col-artist">Artist</div>
            <div class="col-album">Album</div>
            <div class="col-duration">Time</div>
        </div>
    </div>

    <div class="songs-table-container" id="tableContainer">
        <table class="songs-table" id="songsTable">
            <colgroup>
                <col class="col-index">
                <col class="col-artwork">
                <col class="col-title">
                <col class="col-artist">
                <col class="col-album">
                <col class="col-duration">
            </colgroup>
            <tbody id="songsTbody"></tbody>
        </table>
        
        <div class="songs-grid" id="songsGrid" style="display: none;"></div>

        <div class="empty-state" id="emptyState">No songs found. Add some songs to your library!</div>
    </div>
</div>

<script>
    // Inject the song data directly from the model
    window.__songsInitialData = @Html.Raw(JsonSerializer.Serialize(Model));
    // Inject state data directly from stored AppData
    window.__songPageState = ["@appData.ViewType","@appData.SortType"];
    // define a custom action when a song row is clicked
    window.__songClickHandler = async function(_song) {
        try {
            const response = await fetch('/Player/Play', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(_song)
            });

            if (!response.ok) {
                console.error('Play failed');
                return;
            }

        } catch (err) {
            console.error(err);
        }
    };
</script>
<script src="~/js/songs/_songs.js" asp-append-version="true"></script>