<!DOCTYPE html>

@inject EchoNet.Services.IThemeService ThemeService
@inject EchoNet.Utils.AppDataJsonReader AppDataJsonReader
@{
    Theme theme = ThemeService.GetTheme();
}

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EchoNet</title>
    <style>
    :root {
        --name: @theme.Name;
        --mode: @theme.Mode;

        --bg: @theme.Background;
        --surface: @theme.Surface;
        --surface-2: @theme.SurfaceAlt;

        --text: @theme.Text;
        --muted: @theme.MutedText;

        --accent: @theme.Accent;
        --accent-hover: @theme.AccentHover;
        --accent-active: @theme.AccentActive;

        --border: @theme.Border;
        --border-hover: @theme.BorderHover;
        --border-focus: @theme.BorderFocus;

        --focus-ring: @theme.FocusRing;

        --text-on-accent: @theme.TextOnAccent;

        --button-secondary-bg: @theme.ButtonSecondaryBg;
        --button-secondary-hover-bg: @theme.ButtonSecondaryHoverBg;
        --button-secondary-text: @theme.ButtonSecondaryText;

        --input-bg: @theme.InputBg;
        --input-placeholder: @theme.InputPlaceholder;

        --disabled-bg: @theme.DisabledBg;
        --disabled-text: @theme.DisabledText;
    }
    </style>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/toast.css" />
</head>
<body>
    <script src="~/lib/signalR/signalr.min.js"></script>
    <script src="~/js/toast.js"></script>
    <div class="app-layout">

        <!-- SIDEBAR -->
        <partial name="_Sidebar" />

        <!-- MAIN CONTENT -->
        <main class="content" id="mainContent">
            @RenderBody()
        </main>

        <!-- PLAYER -->
        <partial name="_Playerbar" />

    </div>

    <!-- GLOBAL MODAL HOST -->
    <div id="modalHost"></div>

    <script src="~/js/playerbar.js"></script>
    <script type="module" src="~/js/site.js"></script>
</body>
</html>