@inject EchoNet.Services.IAudioService AudioService
@{
    var progress_fraction =
        AudioService.Duration.TotalSeconds > 0
            ? AudioService.CurrentTime.TotalSeconds / AudioService.Duration.TotalSeconds
            : 0;
}

<footer class="player-bar">

    <!-- LEFT -->
    <div class="player-track-info">

        <div class="track-thumb">🎶</div>

        <div class="track-details">
            <span class="track-title">Blinding Lights test 12345678</span>
            <span class="track-artist">The Weeknd</span>
        </div>

    </div>

    <!-- CENTER -->
    <div class="player-controls-wrapper">

        <div class="player-controls">

            <button class="ctrl-btn" title="Favorite">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px"
                    viewBox="0 -960 960 960" 
                    width="24px">
                    <path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Zm0-108q96-86 158-147.5t98-107q36-45.5 50-81t14-70.5q0-60-40-100t-100-40q-47 0-87 26.5T518-680h-76q-15-41-55-67.5T300-774q-60 0-100 40t-40 100q0 35 14 70.5t50 81q36 45.5 98 107T480-228Zm0-273Z"/>
                </svg>
            </button>

            <button class="ctrl-btn" title="Shuffle">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px" 
                    viewBox="0 -960 960 960" 
                    width="24px">
                    <path d="M560-160v-80h104L537-367l57-57 126 126v-102h80v240H560Zm-344 0-56-56 504-504H560v-80h240v240h-80v-104L216-160Zm151-377L160-744l56-56 207 207-56 56Z"/>
                </svg>
            </button>

            <button class="ctrl-btn" title="Previous">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px" 
                    viewBox="0 -960 960 960" 
                    width="24px">
                    <path d="M860-240 500-480l360-240v480Zm-400 0L100-480l360-240v480Zm-80-240Zm400 0Zm-400 90v-180l-136 90 136 90Zm400 0v-180l-136 90 136 90Z"/>
                </svg>
            </button>

            <button class="ctrl-btn play-btn" id="playPauseBtn" title="Play / Pause">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="34px" 
                    viewBox="0 -960 960 960" 
                    width="34px" 
                    fill="var(--bg)">
                    @if (AudioService.IsPlaying)
                    {
                        <path d="M240-200v-560h160v560H240Zm320 0v-560h160v560H560Z"/>
                    }
                    else
                    {
                        <path d="M320-200v-560l440 280-440 280Z"/>
                    }
                </svg>
            </button>

            <button class="ctrl-btn" title="Next">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px" 
                    viewBox="0 -960 960 960" 
                    width="24px"
                    style="transform: scaleX(-1);">
                    <path d="M860-240 500-480l360-240v480Zm-400 0L100-480l360-240v480Zm-80-240Zm400 0Zm-400 90v-180l-136 90 136 90Zm400 0v-180l-136 90 136 90Z"/>
                </svg>
            </button>
            
            <button class="ctrl-btn" title="Lyrics">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px" 
                    viewBox="0 -960 960 960" 
                    width="24px">
                    <path d="M80-80v-720q0-33 23.5-56.5T160-880h440q33 0 56.5 23.5T680-800v17q-24 11-44 27t-36 36v-80H160v527l47-47h393v-160q16 20 36 36t44 27v97q0 33-23.5 56.5T600-240H240L80-80Zm160-320h160v-80H240v80Zm520-80q-50 0-85-35t-35-85q0-50 35-85t85-35q11 0 21 2t19 5v-207h160v80h-80v240q0 50-35 85t-85 35Zm-520-40h280v-80H240v80Zm0-120h280v-80H240v80Zm-80 320v-480 480Z"/>
                </svg>
            </button>

            <button class="ctrl-btn" title="Repeat">
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    height="24px" 
                    viewBox="0 -960 960 960" 
                    width="24px">
                    <path d="M280-80 120-240l160-160 56 58-62 62h406v-160h80v240H274l62 62-56 58Zm-80-440v-240h486l-62-62 56-58 160 160-160 160-56-58 62-62H280v160h-80Z"/>
                </svg>
            </button>

        </div>

        <div class="progress-container">

            <span class="progress-time" id="currentTime">
                @(AudioService.CurrentTime.ToString(@"m\:ss"))
            </span>

            <div class="progress-bar-track" id="progressTrack">

                <div class="progress-bar-fill"
                    id="progressFill"
                    style="width:@(progress_fraction * 100)%">
                </div>

                <div class="progress-bar-thumb"
                    id="progressThumb"
                    style="left:@(progress_fraction * 100)%">
                </div>

            </div>

            <span class="progress-time" id="durationTime">
                @(AudioService.Duration.ToString(@"m\:ss"))
            </span>

        </div>

    </div>

    <!-- RIGHT -->
    <div class="player-volume">

        <button class="volume-icon-btn" title="Queue">
            <svg 
                xmlns="http://www.w3.org/2000/svg" 
                height="24px" 
                viewBox="0 -960 960 960" 
                width="24px">
                <path d="M120-120v-80h720v80H120Zm0-320v-80h720v80H120Zm0-320v-80h720v80H120Z"/>
            </svg>
        </button>

        <button class="volume-icon-btn" id="muteBtn" title="Mute / Unmute">
            <svg 
                xmlns="http://www.w3.org/2000/svg" 
                height="24px" 
                viewBox="0 -960 960 960" 
                width="24px">
                @if (AudioService.Volume <= 0)
                {
                    <path d="M280-360v-240h160l200-200v640L440-360H280Zm80-80h114l86 86v-252l-86 86H360v80Zm100-40Z"/>
                }
                else
                {
                    <path d="M560-131v-82q90-26 145-100t55-168q0-94-55-168T560-749v-82q124 28 202 125.5T840-481q0 127-78 224.5T560-131ZM120-360v-240h160l200-200v640L280-360H120Zm440 40v-322q47 22 73.5 66t26.5 96q0 51-26.5 94.5T560-320ZM400-606l-86 86H200v80h114l86 86v-252ZM300-480Z"/>
                }
            </svg>
        </button>

        <div class="volume-slider-track" id="volumeTrack">

            <div class="volume-slider-fill"
                id="volumeFill"
                style="width:@(AudioService.Volume)%">
            </div>

        </div>

        <button class="volume-icon-btn" title="Fullscreen">
            <svg 
                xmlns="http://www.w3.org/2000/svg" 
                height="24px" 
                viewBox="0 -960 960 960" 
                width="24px">
                <path d="M120-120v-200h80v120h120v80H120Zm520 0v-80h120v-120h80v200H640ZM120-640v-200h200v80H200v120h-80Zm640 0v-120H640v-80h200v200h-80Z"/>
            </svg>
        </button>

    </div>

</footer>