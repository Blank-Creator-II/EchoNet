
<aside>
    <link rel="stylesheet" href="~/css/home/emptyState.css" />
    <section class="empty-state">

    <!-- ── Vinyl record + rings + floating notes ── -->
    <div class="empty-state__vinyl-wrap">

        <!-- Pulsing rings -->
        <div class="empty-state__ring"></div>
        <div class="empty-state__ring empty-state__ring--2"></div>
        <div class="empty-state__ring empty-state__ring--3"></div>

        <!-- Spinning vinyl disc -->
        <svg class="empty-state__disc"
            viewBox="0 0 200 200"
            width="200"
            height="200"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg">
        <!-- Vinyl body -->
        <circle cx="100" cy="100" r="99" fill="var(--surface)" stroke="color-mix(in oklab, var(--accent) 20%, transparent)" stroke-width="0.6"/>
        <!-- Grooves -->
        <circle cx="100" cy="100" r="91" fill="none" stroke="var(--button-secondary-bg)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="84" fill="none" stroke="var(--border)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="77" fill="none" stroke="var(--button-secondary-bg)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="70" fill="none" stroke="var(--border)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="63" fill="none" stroke="var(--button-secondary-bg)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="56" fill="none" stroke="var(--button-secondary-bg)" stroke-width="0.7"/>
        <circle cx="100" cy="100" r="49" fill="none" stroke="var(--surface-2)" stroke-width="1.2"/>
        <!-- Center label -->
        <circle cx="100" cy="100" r="40" fill="var(--accent-active)"/>
        <circle cx="100" cy="100" r="30" fill="var(--accent)"/>
        <circle cx="100" cy="100" r="19" fill="var(--accent-active)"/>
        <!-- Spindle hole -->
        <circle cx="100" cy="100" r="4.5" fill="var(--surface)"/>
        </svg>

        <!-- Tonearm / needle -->
        <svg class="empty-state__tonearm"
            viewBox="0 0 80 110"
            width="80"
            height="110"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg">
        <line x1="18" y1="18" x2="56" y2="96"
                stroke="var(--muted)" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="18" cy="18" r="6"
                fill="none" stroke="var(--muted)" stroke-width="1.5"/>
        <circle cx="55" cy="95" r="3" fill="var(--muted)"/>
        </svg>

        <!-- Floating music note 1 -->
        <span class="empty-state__note empty-state__note--1" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
            stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18V5l12 -2v13"/>
            <circle cx="6"  cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
        </svg>
        </span>

        <!-- Floating music note 2 -->
        <span class="empty-state__note empty-state__note--2" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
            stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18V5l12 -2v13"/>
            <circle cx="6"  cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
        </svg>
        </span>

        <!-- Floating music note 3 -->
        <span class="empty-state__note empty-state__note--3" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
            stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18V5l12 -2v13"/>
            <circle cx="6"  cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
        </svg>
        </span>

    </div><!-- /vinyl-wrap -->

    <!-- ── Text ── -->
    <p class="empty-state__title">Your library is empty</p>
    <p class="empty-state__subtitle">Load your music and start listening right away</p>


    <!-- ── CTA button ── -->
    <button class="empty-state__btn" type="button" id="pickMusicBtn">
        <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true">
        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/>
        <polyline points="7 9 12 4 17 9"/>
        <line x1="12" y1="4" x2="12" y2="16"/>
        </svg>
        Load your music
    </button>

    </section>
</aside>

