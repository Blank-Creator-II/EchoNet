@model (EchoNet.Models.Theme cardTheme, EchoNet.Models.Theme currentTheme)

@{
    string[]? parts = Model.cardTheme.Name.Split(separator: ' ', StringSplitOptions.RemoveEmptyEntries);
    string? firstPart = parts.FirstOrDefault();
    string? lastPart = parts.LastOrDefault();
}

<div class="theme-card">
  <div class="container">
    <div class="canvas-wrapper"
        onclick="selectTheme(this)"
        data-theme="@Model.cardTheme.Name"
        data-mode="@Model.cardTheme.Mode"

        data-background="@Model.cardTheme.Background"
        data-surface="@Model.cardTheme.Surface"
        data-surface-alt="@Model.cardTheme.SurfaceAlt"

        data-text="@Model.cardTheme.Text"
        data-muted-text="@Model.cardTheme.MutedText"

        data-accent="@Model.cardTheme.Accent"
        data-accent-hover="@Model.cardTheme.AccentHover"
        data-accent-active="@Model.cardTheme.AccentActive"

        data-border="@Model.cardTheme.Border"
        data-border-hover="@Model.cardTheme.BorderHover"
        data-border-focus="@Model.cardTheme.BorderFocus"

        data-focus-ring="@Model.cardTheme.FocusRing"
        data-text-on-accent="@Model.cardTheme.TextOnAccent"

        data-button-secondary-bg="@Model.cardTheme.ButtonSecondaryBg"
        data-button-secondary-hover-bg="@Model.cardTheme.ButtonSecondaryHoverBg"
        data-button-secondary-text="@Model.cardTheme.ButtonSecondaryText"

        data-input-bg="@Model.cardTheme.InputBg"
        data-input-placeholder="@Model.cardTheme.InputPlaceholder"

        data-disabled-bg="@Model.cardTheme.DisabledBg"
        data-disabled-text="@Model.cardTheme.DisabledText"

        data-current-Theme-Mode="@Model.currentTheme.Mode"
        style="
          --card-accent: @Model.cardTheme.Accent;
          --card-bg: @Model.cardTheme.Background;
          --card-surface: @Model.cardTheme.Surface;
          --card-mode: '@Model.cardTheme.Mode';">
      <canvas class="fc"></canvas>

      <div class="card-label top-label">
          <p>@firstPart</p>
      </div>

      <div class="card-label bottom-label">
          <p>@lastPart</p>
      </div>
    </div>
  </div>
</div>